# Copy this file to .env and paste your own key to make Cuore use ElevenLabs
# voices by default. The runtime Settings field still overrides it, and the app
# falls back to the browser voice when no key is present.
#
# Warning: anything in .env is baked into the JavaScript bundle at build time.
# If you deploy a build, that bundle is public and the key can be read and
# spent by anyone. For a public deployment, leave this empty and let each user
# paste their own key in Settings.
VITE_ELEVENLABS_API_KEY=
